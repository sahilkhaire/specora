# Production build (Cloudflare Pages → https://specora.varcore.dev)
VITE_DEPLOYMENT_MODE=saas
VITE_APP_SURFACE=full
VITE_ENABLE_SAAS_AUTH=false
VITE_EMBED_CDN_BASE=https://specora.varcore.dev/embed
VITE_PLATFORM_DOCS_DOMAIN=docs.varcore.dev
# API that hosts POST /proxy (try-out CORS bypass). Set CORS_ORIGIN on API to your web origin.
VITE_API_BASE_URL=https://api.specora.varcore.dev
VITE_TRYOUT_USE_PROXY=true
